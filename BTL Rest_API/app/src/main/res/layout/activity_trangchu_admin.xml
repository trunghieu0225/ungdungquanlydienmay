<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#4A86E8"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐIỆN MÁY XANH - ADMIN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn chức năng quản lý"
            android:textColor="#DDEBFF"
            android:textSize="15dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnGoProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ SẢN PHẨM"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A86E8"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnGoCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ LOẠI HÀNG HÓA"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A86E8"
            android:layout_marginTop="16dp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnGoOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ ĐƠN HÀNG"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A86E8"
            android:layout_marginTop="16dp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnGoUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ USER"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A86E8"
            android:layout_marginTop="16dp"
            android:padding="14dp"/>

        <Button
            android:id="@+id/btnGoPromotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ KHUYẾN MÃI"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4A86E8"
            android:layout_marginTop="16dp"
            android:padding="14dp"/>

    </LinearLayout>
</LinearLayout>